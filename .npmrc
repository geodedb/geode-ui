# npm configuration for geode-ui
#
# GitLab Package Registry for @devnw scope
# This configures npm to pull @devnw/* packages (e.g. @devnw/playwright-scanner-kit)
# from the private GitLab registry instead of the public npm registry.
#
# For local development, you need a GitLab Personal Access Token (PAT) with read_api scope.
#
# IMPORTANT: Do NOT commit tokens to this file.
# Use environment variables or a local ~/.npmrc instead:
#   echo "//gitlab.com/api/v4/packages/npm/:_authToken=YOUR_TOKEN" >> ~/.npmrc

@devnw:registry=https://gitlab.com/api/v4/packages/npm/
