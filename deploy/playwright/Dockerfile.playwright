# syntax=docker/dockerfile:1.29
# Pre-baked Playwright runner for CI. Has Node + Playwright 1.64 +
# Chromium baked in, with the e2e package layout staged.
FROM mcr.microsoft.com/playwright:v1.65.1-jammy

WORKDIR /work
COPY package.json package-lock.json ./
RUN npm ci --omit=optional

COPY e2e/ ./e2e/
ENV CI=1
ENTRYPOINT ["npx", "playwright", "test", "--config=e2e/playwright.config.ts"]
