# syntax=docker/dockerfile:1.7
# Pre-baked Playwright runner for CI. Has Node 22 + Playwright 1.59 +
# Chromium baked in, with the e2e package layout staged.
# image-pin: 2026-05-16 @ matches @playwright/test pin in package.json;
# refresh both in lockstep when Playwright is bumped.
FROM mcr.microsoft.com/playwright:v1.59.1-jammy

WORKDIR /work
# .npmrc maps the @devnw scope to the private GitLab npm registry (see
# ../../.npmrc) — it must land before `npm ci` so @devnw/* packages (e.g.
# @devnw/playwright-scanner-kit) resolve. The auth token is supplied at
# build time via BuildKit's --secret mechanism (`docker build --secret
# id=npm_auth_token,env=DEVNW_NPM_REGISTRY_TOKEN`) and only exported for
# the lifetime of the `npm ci` RUN step, so it never lands in an image
# layer or `docker history`.
COPY package.json package-lock.json .npmrc ./
RUN --mount=type=secret,id=npm_auth_token \
    export DEVNW_NPM_REGISTRY_TOKEN="$(cat /run/secrets/npm_auth_token)" && \
    npm ci --omit=optional

COPY e2e/ ./e2e/
ENV CI=1
ENTRYPOINT ["npx", "playwright", "test", "--config=e2e/playwright.config.ts"]
