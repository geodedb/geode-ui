# syntax=docker/dockerfile:1.29
#
# Geode engine image for the geode-ui e2e test stack.
#
# Based on the published Geode release image (registry.gitlab.com/devnw/
# codepros/geode/geode), pinned by digest. 0.8.22 is the newest release
# image; the geodedb.com/geode 0.2.x Go driver this UI uses targets engine
# 0.8.18 and later. Older e2e stacks built geode v0.5.15 from source with
# Zig. That engine leaks every connection the 0.2 driver opens and
# closes, which is why the driver was held at 0.1.28.
#
# The release image ships geode, bash and apt but no tini or socat. The
# compose file runs geode under tini (so SIGTERM reaches `geode serve`)
# and bridges the MCP and LSP stdio servers over TCP with socat, so both
# are installed here at build time instead of on every container start.
#
# Build (run from geode-ui/):
#   docker build -f deploy/geode/Dockerfile.geode -t geode:e2e deploy/geode
FROM registry.gitlab.com/devnw/codepros/geode/geode:0.8.25@sha256:a4648af36bb942fe51a6dec489b95306bd492318f1d2de4b441b928ed6a8ec54

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends tini socat \
    && rm -rf /var/lib/apt/lists/*

# Docker daemons used by CI do not necessarily share the job's checkout.
# Carry the test fixtures in the image so every service sees the same files.
COPY --chmod=0555 geode-entrypoint.sh /geode-entrypoint.sh
COPY --chmod=0555 seed-bootstrap.sh /seed/seed-bootstrap.sh
COPY --chmod=0444 init.gql vulndb.gql /seed/
COPY --chmod=0555 mcp-bridge.sh mcp-stdio-launch.sh /mcp/
COPY --chmod=0555 lsp-bridge.sh /lsp/lsp-bridge.sh
USER geode

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/geode"]
CMD ["serve", "--data-dir", "/data", "--listen", "0.0.0.0:3141"]
