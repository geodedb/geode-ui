{
  "name": "@geodedb/ui",
  "version": "0.1.0",
  "description": "Geode graph database admin & query UI",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/devnw/react/ui.git"
  },
  "scripts": {
    "start": "webpack serve --config webpack.dev.js",
    "build": "NODE_ENV=production webpack --config webpack.prod.js",
    "test": "jest --config jest.config.cjs",
    "test:ts": "tsc --noEmit",
    "test:watch": "jest --config jest.config.cjs --watch",
    "lint": "eslint src/ --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "prettier:check": "prettier --check 'src/**/*.{ts,tsx,json,css}'",
    "prettier:fix": "prettier --write 'src/**/*.{ts,tsx,json,css}'",
    "clean": "rm -rf dist build coverage"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "cytoscape": "^3.33.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^7.5.0",
    "styled-components": "^6.1.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/cytoscape": "^3.21.9",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-loader": "^9.1.0",
    "babel-plugin-styled-components": "^2.1.0",
    "copy-webpack-plugin": "^12.0.0",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react": "^7.34.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.8.0",
    "prettier": "^3.3.0",
    "style-loader": "^3.3.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.0",
    "typescript": "~5.8.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.0.0",
    "webpack-merge": "^5.10.0"
  }
}
