{
  "name": "@geodedb/ui",
  "version": "0.1.1",
  "description": "Geode graph database admin & query UI",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/devnw/react/ui.git"
  },
  "scripts": {
    "start": "webpack serve --config webpack.dev.js",
    "build": "NODE_ENV=production webpack --config webpack.prod.js",
    "test": "jest --config jest.config.cjs",
    "test:ts": "tsc --noEmit",
    "test:watch": "jest --config jest.config.cjs --watch",
    "lint": "eslint src/ --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "lint:hardcoded-styles": "node scripts/check-hardcoded-styles.mjs",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "verify:translations": "node scripts/validate-translations.mjs --required-locales=en --max-warnings-total=0",
    "detect:hardcoded-strings": "node scripts/detect-hardcoded-strings.mjs --strict",
    "check:html-renderers": "node scripts/check-html-renderers.mjs",
    "prettier:check": "prettier --check 'src/**/*.{ts,tsx,json,css}'",
    "prettier:fix": "prettier --write 'src/**/*.{ts,tsx,json,css}'",
    "clean": "rm -rf dist build coverage",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "e2e:debug": "PWDEBUG=1 playwright test --config=e2e/playwright.config.ts",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "e2e:smoke": "playwright test --config=e2e/playwright.config.ts e2e/specs/01-auth.spec.ts",
    "electron:tsc": "tsc --project electron/tsconfig.json",
    "electron:assemble": "npm run electron:tsc && node scripts/stage-electron-ui.mjs",
    "electron:build": "npm run build && npm run electron:assemble",
    "electron:dev": "pnpm run electron:build && electron internal/ui/electron-dist/main.js",
    "electron:package": "electron-builder --config electron-builder.yml"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "npm@12.2.3",
  "overrides": {
    "dompurify": "^3.4.0",
    "@react-three/fiber": {
      "its-fine": "2.1.1"
    }
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@monaco-editor/react": "^4.7.0",
    "cytoscape": "^3.34.3",
    "cytoscape-cxtmenu": "^3.5.0",
    "cytoscape-dagre": "^4.0.1",
    "cytoscape-dom-node": "^2.1.0",
    "cytoscape-fcose": "^2.2.0",
    "cytoscape-lasso": "^1.1.4",
    "cytoscape-navigator": "^2.0.2",
    "cytoscape-popper": "^4.0.1",
    "cytoscape-spread": "^3.0.0",
    "i18next": "^27.0.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "intl-pluralrules": "^2.0.1",
    "monaco-languageclient": "^8.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^18.0.0",
    "react-router-dom": "^7.18.4",
    "react-window": "^2.3.4",
    "reagraph": "^4.32.0",
    "styled-components": "^6.5.3",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-protocol": "^3.18.4",
    "vscode-ws-jsonrpc": "^4.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/cytoscape-dagre": "^2.3.4",
    "@types/cytoscape-fcose": "^2.2.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3",
    "@types/react-dom": "19.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "electron": "^45.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "monaco-editor": "^0.58.0",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "prettier": "^3.9.10",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  }
}
