# Go build artifacts
/bin/

# Coverage
*.out
coverage.txt

# Playwright
/e2e/playwright-report/
/e2e/test-results/
/e2e/.cache/

# Electron-builder output (release/<platform>/*.dmg|AppImage|deb|exe)
/release/
/internal/ui/electron-dist/

# GoReleaser output (already covered by /dist/ above; mirror for clarity)
/dist/

# Playwright writes to ./test-results when run with --config=e2e/playwright.config.ts
# from the repo root (the /e2e/test-results entry above only covers the e2e/ cwd case)
/test-results/

# Claude Code per-project config / memory
/.claude/

# Audit scratch space (gosec / gitleaks / govulncheck / semgrep / npm-audit
# raw output + triage notes). S-09 (#272) — never to be committed. The
# `.gitleaks.toml` allowlist also exempts this prefix so a local
# gitleaks scan does not flag the cached artefacts.
/.scratch/

# Stray build artifacts (a `go build` without -o bin/, an accidental pnpm install)
/server
/pnpm-lock.yaml

# QUALITY #177: code-generation staleness sentinel; locally written
# by `make generate` to skip a no-op regen when geode.json hasn't
# changed. Recreated by the next `make generate` after deletion.
/gen/.sentinel

# Electron-builder output (release/<platform>/*.AppImage|deb|dmg|exe)
/release/

# Electron e2e Playwright HTML report (e2e/electron.config.ts writes
# here per-run).
/e2e/playwright-report-electron/

# Serena MCP cache (per-repo, machine-local).
/.serena/

# Transient `npm test`/`go test` output redirects.
/test-output.txt
