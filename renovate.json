{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Keep Go directives on the latest stable release, including minor upgrades.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Update Go and golangci-lint together; merge only after required checks pass.",
      "matchPackageNames": [
        "go",
        "golang",
        "golangci/golangci-lint",
        "github.com/golangci/golangci-lint/v2",
        "github.com/golangci/golangci-lint",
        "devnw/utility-projects/org-pre-commit-hooks",
        "devnw/ci-catalog",
        "/^(?:registry\\.gitlab\\.com/devnw/ci-catalog/)?go(?:lang|-ci)?$/"
      ],
      "groupName": "Go toolchain and golangci-lint",
      "enabled": true,
      "ignoreUnstable": true,
      "automerge": true,
      "dependencyDashboardApproval": false,
      "schedule": [
        "at any time"
      ],
      "commitMessageSuffix": "(SONNY-2928)",
      "semanticCommitType": "chore",
      "semanticCommitScope": null
    },
    {
      "description": "Hold TypeScript below 7: TS 7 ships no JS compiler API (the package exports only lib/version.cjs), so ts-loader, ts-jest (peer typescript <7) and typescript-eslint (peer typescript <6.1) cannot run on it.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "Hold ESLint at 8: eslint-config-airbnb 19 (peer eslint ^7 || ^8) and eslint-plugin-import/react/jsx-a11y do not support ESLint 10, and ESLint 9+ needs a flat-config rewrite that replaces the airbnb preset.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "eslint"
      ],
      "allowedVersions": "<9"
    },
    {
      "description": "Hold monaco-languageclient at 8: version 9+ requires the @codingame/monaco-vscode-api service stack (v11 pins vscode-api 37) and replacing the @monaco-editor/react editor integration.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "monaco-languageclient"
      ],
      "allowedVersions": "<9"
    },
    {
      "description": "Hold vscode-languageclient at 9 to match monaco-languageclient 8, which depends on vscode-languageclient ~9.0.1 (CloseAction/ErrorAction must come from the same copy).",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "vscode-languageclient"
      ],
      "allowedVersions": "<10"
    },
    {
      "description": "Hold github.com/lestrrat-go/jwx at v1: it is imported only by genapi-generated code (gen/pkg/oidcx), so the move to the jwx/v4 module path has to come from the generator, not a hand edit of gen/.",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/lestrrat-go/jwx"
      ],
      "allowedVersions": "<2"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(Makefile|Dockerfile[^/]*|[^/]+\\.(mk|sh|py|ya?ml))$/"
      ],
      "matchStrings": [
        "(?:GOLANGCI_LINT_VERSION|golangci_version)[^\\n]*?[=:][ \\t?=\"\\x27]*(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "# Updated for golangci-lint (?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "golangci_version:\\s+default: [\"\\x27]?(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "github\\.com/golangci/golangci-lint(?:/v2)?/cmd/golangci-lint@(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "repo: https://github\\.com/golangci/golangci-lint\\s+rev: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(Makefile|Dockerfile[^/]*|[^/]+\\.(mk|sh|py|ya?ml))$/"
      ],
      "matchStrings": [
        "(?:GO_VERSION|GO_VERSIONS|go_version|GOTOOLCHAIN|DESKTOP_GO_VERSION|GOVERSION)[ \\t?]*[=:][ \\t\"\\x27\\[]*(?:go)?(?<currentValue>1\\.\\d+\\.\\d+)",
        "go_version:\\s+default: [\"\\x27]?(?<currentValue>1\\.\\d+\\.\\d+)",
        "golang:[ \\t\"\\x27]*(?<currentValue>1\\.\\d+\\.\\d+)",
        "GOTOOLCHAIN[^\\n]*?[=:][^\\n]*?go(?<currentValue>1\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "go-mod-directive"
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
