{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "es2015",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "sourceMap": true,
    "lib": ["dom", "esnext"],
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "jest"],
    "outDir": "./dist/",
    "paths": {
      "@/*": ["./src/*"],
      "@api": ["./gen/client/react/index.ts"],
      "@api/*": ["./gen/client/react/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "__test_utils__"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "gen/client/react/**/*"
  ]
}
