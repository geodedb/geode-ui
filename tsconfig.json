{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "es2015",
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "allowJs": true,
    "sourceMap": true,
    "downlevelIteration": true,
    "lib": ["dom", "esnext"],
    "typeRoots": ["node_modules/@types"],
    "baseUrl": ".",
    "outDir": "./dist/",
    "paths": {
      "@/*": ["src/*"],
      "@api": ["gen/client/react/index.ts"],
      "@api/*": ["gen/client/react/*"],
      "monaco-editor": ["node_modules/monaco-editor/esm/vs/index.d.ts"],
      "vscode-languageclient": [
        "node_modules/vscode-languageclient/lib/common/api.d.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "__test_utils__"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "gen/client/react/**/*"
  ]
}
